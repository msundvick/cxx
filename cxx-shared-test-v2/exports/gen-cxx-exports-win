#!/usr/bin/env bash
# Extracts cxx.cc (cxxbridge1) symbols from the Windows static lib and writes
# them to cxx-exports-win.txt.  Run this once after a cxx version bump, then
# commit the output file.
#
# Invoke from the cxx-shared-test-v2 directory:
#   ./exports/cxx-clean
#   rm -f ./exports/cxx-exports-win.txt
#   cargo build
#   ./exports/gen-cxx-exports-win
#   cargo build   # verify linking with the new exports
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
out="$script_dir/cxx-exports-win.txt"

# Find cxxbridge1.lib anywhere under target/
lib=$(find "$repo_root/target" -name "cxxbridge1.lib" 2>/dev/null | head -1)
if [ -z "$lib" ]; then
    echo "error: cxxbridge1.lib not found under $repo_root/target. Run 'cargo build' first." >&2
    exit 1
fi

echo "# cxx.cc (cxxbridge1) symbols for Windows MSVC" > "$out"
echo "# Generated from: $lib" >> "$out"
echo "# Re-generate with: ./exports/gen-cxx-exports-win" >> "$out"

bash "$script_dir/extract-symbols-win" "cxxbridge1" "$lib" >> "$out"

echo "Wrote $(grep -c '^[^#]' "$out") symbols to $out"
