#!/usr/bin/env bash
# Usage: extract-symbols-win <grep-pattern> <path-to-archive.lib>
# Lists mangled MSVC symbols from a static library matching the given pattern.
# Output: one symbol per line, sorted and deduplicated.
set -euo pipefail

pattern="$1"
lib="$2"

# dumpbin must be on PATH (set up by ilammy/msvc-dev-cmd or MSVC environment)
dumpbin /LINKERMEMBER:1 "$lib" 2>/dev/null \
    | grep -E '^\s+[0-9A-Fa-f]+ \?' \
    | awk '{print $2}' \
    | grep "$pattern" \
    | LC_ALL=C sort -u
